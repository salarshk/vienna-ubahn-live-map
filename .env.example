# CARTO Basemap API Key (optional)
# As of August 2026, CARTO requires a free API key to use their basemap tiles without an "API KEY REQUIRED" watermark.
# You can get a free key instantly (with 5 million requests/month) at:
# https://carto.com/basemaps/apikey
#
# If left blank, the app automatically falls back to a clean, keyless grayscale canvas basemap.
VITE_CARTO_API_KEY=

# Optional public context override. The app uses the official defaults when blank.
VITE_AIR_QUALITY_API_URL=

# Optional Cloudflare Worker shared network inference endpoint. In production
# the app uses the deployed advisor Worker endpoint by default; set this only
# when the Worker has a different hostname.
VITE_NETWORK_API_URL=

# Optional external secure GPT advisor endpoint. Do not use the OpenAI API URL
# directly in the browser; that would expose your API key.
VITE_ENABLE_AI_ADVISOR=false
VITE_ADVISOR_API_URL=

# Optional licensed relays/partner endpoints. Leave blank to show the source as
# awaiting access; do not put private tokens or credentials in this file.
VITE_VIENNA_EVENTS_API_URL=
VITE_EVIS_API_URL=
VITE_VAO_API_URL=
VITE_OEBB_CONTEXT_API_URL=
VITE_OEBB_GREENLIGHT_API_URL=
VITE_PASSENGER_COUNT_API_URL=
VITE_VEHICLE_TELEMETRY_API_URL=
VITE_MOBILE_MOVEMENT_API_URL=
